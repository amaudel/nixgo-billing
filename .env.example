# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a Git.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Salta RLS: usar únicamente en API routes con la organización ya resuelta.
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor de facturación: "mock" (por defecto, sin red) o "factuplan" ---
BILLING_PROVIDER=mock

# --- Factuplan (vacíos hasta que exista integración real; ver docs/FACTUPLAN.md) ---
FACTUPLAN_API_KEY_TEST=
FACTUPLAN_API_KEY_LIVE=
FACTUPLAN_WEBHOOK_SECRET=

# --- Webhook del proveedor mock (solo desarrollo) ---
MOCK_WEBHOOK_SECRET=dev-only-mock-secret
